# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ame:ame@localhost:5432/ame
POSTGRES_USER=ame
POSTGRES_PASSWORD=ame
POSTGRES_DB=ame

# --- Object storage (datasets/models/reports/artifacts) ---
ARTIFACT_STORAGE_PATH=./data/artifacts

# --- LLM / Agent ---
OPENAI_API_KEY=
AGENT_MODEL=gpt-4.1

# --- Budgets (defaults, overridable per-project) ---
DEFAULT_MAX_EXPERIMENTS=30
DEFAULT_MAX_RUNTIME_MINUTES=30
DEFAULT_MAX_COMPUTE_COST=5
DEFAULT_MINIMUM_IMPROVEMENT=0.002

# --- Execution sandbox ---
SANDBOX_CPU_LIMIT=2
SANDBOX_RAM_LIMIT_MB=2048
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_NETWORK_ENABLED=false

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
